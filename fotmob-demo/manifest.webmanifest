{
  "id": "./",
  "name": "Matchday · Football scores",
  "short_name": "Matchday",
  "description": "Football scores, real football news, league tables and fixtures.",
  "start_url": "./?source=installed-app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f5f6f7",
  "theme_color": "#047857",
  "categories": ["sports", "news"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icons/matchday-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/matchday-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/matchday-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
