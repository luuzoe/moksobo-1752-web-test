{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matchday-espn-live",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "SCORE_POLLERS", "class_name": "ScoreboardPoller" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ScoreboardPoller"] }
  ]
}
